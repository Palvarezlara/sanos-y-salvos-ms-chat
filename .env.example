# Copiar a .env (gitignored) y completar antes de levantar con docker-compose.
# Los valores de Cognito son los mismos del resto del proyecto (ver ENV-EQUIPO.txt).

# Misma URI de Atlas que ms-mascotas, pero apuntando a una base propia: .../sanos_chat
MONGODB_URI=

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Clave para firmar el ticket del WebSocket. DEBE ser la misma en ms-chat y en el BFF.
# Genera una con: openssl rand -base64 48
CHAT_TICKET_SECRET=

# Orígenes del frontend permitidos para abrir el WebSocket (separados por coma)
CHAT_ALLOWED_ORIGINS=http://localhost:5173
# Cuánto se conservan los mensajes (formato 90d, 12h, etc.)
CHAT_RETENCION=90d
